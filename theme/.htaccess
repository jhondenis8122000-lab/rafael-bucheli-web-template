Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

AddType image/webp .webp

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{THE_REQUEST} \s/+inicio\.html[\s?] [NC]
    RewriteRule ^inicio\.html$ /index.html [L,R=301]

    RewriteCond %{THE_REQUEST} \s/+pscologia\.html[\s?] [NC]
    RewriteRule ^pscologia\.html$ /psicologia.html [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|otf|eot|mp4|webm)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(html)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<FilesMatch "(^\.|package\.json|gulpfile\.js|README\.md|LICENCE|\.jshintrc|\.editorconfig|package-lock\.json|yarn\.lock)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(bak|config|dist|env|git|ini|log|old|orig|save|sql|swp|tmp|yaml|yml)$">
    Require all denied
</FilesMatch>
